    <string name="monet_neutral">নিউট্রাল</string>
    <string name="monet_neutral_desc">স্প্রিটজ পানীয়ের উচ্ছ্বাস দ্বারা অনুপ্রাণিত প্রাণবন্ত এবং সতেজ রঙের প্যালেট।</string>
    <string name="monet_monochrome">একরঙা</string>
    <string name="monet_monochrome_desc">মসৃণ এবং ন্যূনতম নান্দনিকতার জন্য একটি একক রঙের বৈচিত্র্য ব্যবহার করে সুরেলা স্কিম।</string>
    <string name="monet_tonalspot">টোনাল স্পট</string>
    <string name="monet_tonalspot_desc">স্বরের সূক্ষ্ম বৈচিত্র্যের প্যালেট, যা একটি পরিশীলিত এবং সূক্ষ্ম দৃশ্যমান প্রভাব তৈরি করে।</string>
    <string name="monet_vibrant">প্রাণবন্ত</string>
    <string name="monet_vibrant_desc">প্রাণবন্ততা এবং তীব্রতা প্রকাশ করে এমন উদ্যমী এবং গতিশীল রঙের সংমিশ্রণ।</string>
    <string name="monet_rainbow">রংধনু</string>
    <string name="monet_rainbow_desc">রঙের বৈচিত্র্যময় বর্ণালী, বৈচিত্র্য, কৌতুকপূর্ণতা এবং বিস্তৃত সম্ভাবনার প্রতীক।</string>
    <string name="monet_expressive">ভাবপূর্ণ</string>
    <string name="monet_expressive_desc">আবেগ এবং সৃজনশীলতা প্রকাশ করে এমন রঙের সাহসী এবং অভিব্যক্তিপূর্ণ মিশ্রণ।</string>
    <string name="monet_fidelity">বিশ্বস্ততা</string>
    <string name="monet_fidelity_desc">রঙের বিশ্বস্ত উপস্থাপনা, দৃশ্যমান উপস্থাপনায় নির্ভুলতা এবং সত্যতা নিশ্চিত করে।</string>
    <string name="monet_fruitsalad">ফলের সালাদ</string>
    <string name="monet_fruitsalad_desc">রঙের একচেটিয়া মিশ্রণ যা তাজা এবং রসালো ফলের প্রাণবন্ত ভাণ্ডারের কথা মনে করিয়ে দেয়।</string>
    <string name="monet_content">কন্টেন্ট</string>
    <string name="monet_content_desc">সুষম এবং প্রশান্ত প্যালেট, প্রশান্তি এবং তৃপ্তির অনুভূতি প্রচার করে।</string>
