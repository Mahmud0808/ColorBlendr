    <string name="monet_monochrome">Μονόχρωμο</string>
    <string name="monet_monochrome_desc">Αρμονικό σχέδιο με παραλλαγές μιας ενιαίας απόχρωσης για μια κομψή και μινιμαλιστική αισθητική.</string>
    <string name="monet_tonalspot">Tonal Σημείο</string>
    <string name="monet_tonalspot_desc">Παλέτα με λεπτές παραλλαγές στον τόνο, δημιουργώντας μια εκλεπτυσμένη και λεπτή οπτική επίδραση.</string>
    <string name="monet_vibrant">Έντονο</string>
    <string name="monet_vibrant_desc">Ενεργειακός και δυναμικός συνδυασμός χρωμάτων που αποπνέει ζωντάνια και ένταση.</string>
    <string name="monet_rainbow">Ουράνιο Τόξο</string>
    <string name="monet_rainbow_desc">Διαφορετικό φάσμα χρωμάτων, που συμβολίζει την ποικιλομορφία, το παιχνίδι και ένα ευρύ φάσμα δυνατοτήτων.</string>
    <string name="monet_expressive">Εκφραστικό</string>
    <string name="monet_expressive_desc">Έντονη και εκφραστική μίξη χρωμάτων που μεταφέρει συναίσθημα και δημιουργικότητα.</string>
    <string name="monet_fidelity">Πιστότητα</string>
    <string name="monet_fidelity_desc">Πιστή αναπαράσταση των χρωμάτων, εξασφαλίζοντας ακρίβεια και αυθεντικότητα στην οπτική αναπαράσταση.</string>
    <string name="monet_fruitsalad">Φρουτοσαλάτα</string>
    <string name="monet_fruitsalad_desc">Εκλεκτικό μείγμα χρωμάτων που θυμίζει μια ζωντανή ποικιλία από φρέσκα και ζουμερά φρούτα.</string>
    <string name="monet_content">Περιεχόμενο</string>
