    <!-- Styles -->
    <string name="monet_neutral">Neutralny</string>
    <string name="monet_neutral_desc">Ożywiająca i odświeżająca paleta kolorów inspirowana musujami napojów spirytusowych.</string>
    <string name="monet_monochrome">Monochromatyczny</string>
    <string name="monet_monochrome_desc">Harmonijny schemat oparty na wariacjach jednego odcienia, zapewniający elegancki i minimalistyczny wygląd.</string>
    <string name="monet_tonalspot">Punkt Tonalny</string>
    <string name="monet_tonalspot_desc">Paleta charakteryzująca się subtelnymi różnicami tonu, powodując wyrafinowane i zróżnicowane oddziaływanie wizualne.</string>
    <string name="monet_vibrant">Wyrazisty</string>
    <string name="monet_vibrant_desc">Energiczna i dynamiczna kombinacja kolorów, która wydechuje żywość i intensywność.</string>
    <string name="monet_rainbow">Tęcza</string>
    <string name="monet_rainbow_desc">Zróżnicowane spektrum kolorów, symbolizacja różnorodności i szeroki zakres możliwości.</string>
    <string name="monet_expressive">Ekspresyjny</string>
    <string name="monet_expressive_desc">Pogrubiona i ekspresywna mieszanka kolorów, która daje emocje i kreatywność.</string>
    <string name="monet_fidelity">Dokładność</string>
    <string name="monet_fidelity_desc">Uczciwa reprezentacja kolorów, zapewniająca dokładność i autentyczność w reprezentacji wizualnej.</string>
    <string name="monet_fruitsalad">Sałatka owocowa</string>
    <string name="monet_fruitsalad_desc">Eklektyczna mieszanka kolorów przypominająca żywy asortyment świeżych i sokowych owoców.</string>
    <string name="monet_content">Zawartość</string>
    <string name="monet_content_desc">Zrównoważona i uspokajająca paleta, dająca poczucie uspokojenia i zadowolenia.</string>
    <string name="monet_cmf">CMF</string>
    <string name="monet_cmf_desc">Dynamic dual-source palette that fuses complementary colors for a rich, expressive, and modern aesthetic.</string>
