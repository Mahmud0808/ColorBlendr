    <string name="monet_neutral_desc">Tavolozza di colori vivace e rinfrescante ispirata all\'effervescenza delle bevande spritz.</string>
    <string name="monet_monochrome">Monocromatico</string>
    <string name="monet_monochrome_desc">Schema armonioso che utilizza le variazioni di una tonalità singola per un\'estetica elegante e minimalista.</string>
    <string name="monet_tonalspot">Punto Tonale</string>
    <string name="monet_tonalspot_desc">Tavolozza con sottili variazioni di tono, creando un impatto visivo sofisticato e sfumato.</string>
