    <string name="monet_expressive_desc">Mix audace ed espressivo di colori che trasmette emozione e creatività.</string>
    <string name="monet_fidelity">Fedeltà</string>
    <string name="monet_fidelity_desc">Rappresentazione fedele dei colori, garantendo precisione e autenticità nella rappresentazione visiva.</string>
    <string name="monet_fruitsalad">Insalata di Frutta</string>
    <string name="monet_fruitsalad_desc">Miscela eclettica di colori che ricordano un vivace assortimento di frutta fresca e succosa.</string>
    <string name="monet_content">Contenuto</string>
    <string name="monet_content_desc">Tavolozza equilibrata e calmante, promuovendo un senso di tranquillità e soddisfazione.</string>
