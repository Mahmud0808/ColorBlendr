    <!-- Styles -->
    <string name="monet_neutral">中性</string>
    <string name="monet_neutral_desc">充滿活力且清新的調色板，靈感來自氣泡飲料的生動效果。</string>
    <string name="monet_monochrome">單色</string>
    <string name="monet_monochrome_desc">使用單一色調的變化，打造簡約而時尚的和諧配色。</string>
    <string name="monet_tonalspot">色調點</string>
    <string name="monet_tonalspot_desc">具有色調微妙變化的調色板，創造精緻且細膩的視覺衝擊。</string>
    <string name="monet_vibrant">鮮豔</string>
    <string name="monet_vibrant_desc">充滿能量且動態的顏色組合，展現生機與強烈感。</string>
    <string name="monet_rainbow">彩虹</string>
    <string name="monet_rainbow_desc">豐富多元的色彩光譜，象徵多樣性、玩樂與無限可能。</string>
    <string name="monet_expressive">表現力</string>
    <string name="monet_expressive_desc">大膽且富有表現力的顏色混合，傳遞情感與創造力。</string>
    <string name="monet_fidelity">忠實</string>
    <string name="monet_fidelity_desc">忠實呈現色彩，確保視覺表現的準確性與真實性。</string>
    <string name="monet_fruitsalad">水果沙拉</string>
    <string name="monet_fruitsalad_desc">如同充滿活力的新鮮多汁水果組合，呈現折衷且豐富的顏色混合。</string>
    <string name="monet_content">內容</string>
    <string name="monet_content_desc">平衡且令人平靜的調色板，營造出一種寧靜與滿足感。</string>
    <string name="monet_cmf">CMF</string>
    <string name="monet_cmf_desc">Dynamic dual-source palette that fuses complementary colors for a rich, expressive, and modern aesthetic.</string>
